//@version=6
indicator("London ORB · MNQ", shorttitle = "LDN ORB MNQ", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_SES  = "Session"
const string G_RISK = "Risk & position sizing"
const string G_TRD  = "Trade rules"
const string G_VIS  = "Display"

tzInput      = input.string("UTC+2", "Timezone", group = G_SES, tooltip = "Fixed offsets like UTC+2 do not follow daylight saving. Use an IANA name (e.g. Europe/London) to follow DST.")
orSession    = input.session("0700-0715:23456", "Opening range", group = G_SES)
entrySession = input.session("0715-1100:23456", "Entry window", group = G_SES, tooltip = "Breakouts are only taken inside this window.")
holdSession  = input.session("0715-2200:23456", "Holding window", group = G_SES, tooltip = "An open trade is closed at the first bar outside this window.")

accountSize  = input.float(50000, "Account size ($)", minval = 100, step = 1000, group = G_RISK)
riskPct      = input.float(1.0, "Risk per trade (%)", minval = 0.01, maxval = 10, step = 0.05, group = G_RISK)
maxContracts = input.int(10, "Max contracts", minval = 1, group = G_RISK)
commission   = input.float(1.24, "Round-trip cost per contract ($)", minval = 0, step = 0.01, group = G_RISK, tooltip = "Commission + exchange fees, included in the sizing math.")

entryMode = input.string("Close", "Breakout trigger", options = ["Close", "Touch"], group = G_TRD, tooltip = "Close: bar must close outside the range (entry at close).\nTouch: entry when price trades through the range edge (stop-order style).")
stopMode  = input.string("Opposite side", "Stop placement", options = ["Opposite side", "Range midpoint"], group = G_TRD)
rrTarget  = input.float(2.0, "Target (R multiple)", minval = 0.25, step = 0.25, group = G_TRD)
minRange  = input.float(10, "Min range (pts)", minval = 0, group = G_TRD)
maxRange  = input.float(80, "Max range (pts)", minval = 0, group = G_TRD)

showTable = input.bool(true, "Show info table", group = G_VIS)
colRange  = input.color(color.new(color.gray, 85), "Range fill", group = G_VIS)
colLong   = input.color(color.teal, "Long", group = G_VIS)
colShort  = input.color(color.red, "Short", group = G_VIS)

// ───────────────────────────── Guards ─────────────────────────────
bool  isMNQ   = syminfo.root == "MNQ"
float pv      = syminfo.pointvalue    // $2 per point on MNQ
int   tfSec   = timeframe.in_seconds()
bool  tfOK    = timeframe.isintraday and tfSec <= 900 and 900 % tfSec == 0
bool  enabled = isMNQ and tfOK

// ───────────────────────────── Sessions ─────────────────────────────
bool inOR    = not na(time(timeframe.period, orSession, tzInput))
bool inEntry = not na(time(timeframe.period, entrySession, tzInput))
bool inHold  = not na(time(timeframe.period, holdSession, tzInput))
bool orStart = inOR and not inOR[1]
bool orEnd   = not inOR and inOR[1]

float riskUSD = accountSize * riskPct / 100

// Contracts such that (stop distance × $/pt + costs) × qty ≤ risk budget.
sizeFor(float stopPts) =>
    float perContract = stopPts * pv + commission
    perContract > 0 ? math.min(maxContracts, math.floor(riskUSD / perContract)) : 0

// ───────────────────────────── State ─────────────────────────────
var float  orHigh      = na
var float  orLow       = na
var bool   orReady     = false
var bool   rangeOK     = false
var bool   tradedToday = false
var int    pos         = 0          // 1 long, -1 short, 0 flat
var int    qty         = 0
var float  entryPx     = na
var float  stopPx      = na
var float  targetPx    = na
var int    entryBar    = na
var string status      = "Waiting for range"
var float  dayPnL      = 0.0
var float  netPnL      = 0.0
var int    trades      = 0
var int    wins        = 0
var box    orBox       = na
var line   lnEntry     = na
var line   lnStop      = na
var line   lnTarget    = na

bool longFired  = false
bool shortFired = false
bool exitFired  = false

// ───────────────────────────── Opening range ─────────────────────────────
if orStart
    orHigh      := high
    orLow       := low
    orReady     := false
    rangeOK     := false
    tradedToday := false
    dayPnL      := 0.0
    status      := "Building range"
    if isMNQ
        orBox := box.new(bar_index, high, bar_index, low, border_color = color.new(color.gray, 50), bgcolor = colRange)
else if inOR and not orReady
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

if inOR and not na(orBox)
    box.set_top(orBox, orHigh)
    box.set_bottom(orBox, orLow)
    box.set_right(orBox, bar_index)

if orEnd and not na(orHigh)
    orReady := true
    float rng = orHigh - orLow
    rangeOK := rng >= minRange and rng <= maxRange
    status  := rangeOK ? "Range set — waiting for breakout" : "Range " + str.tostring(rng, "#.##") + " pts outside filter — no trade"

// Keep the range box running through the entry window.
if orReady and inEntry and not na(orBox)
    box.set_right(orBox, bar_index)

// ───────────────────────────── Manage open trade ─────────────────────────────
if pos != 0 and bar_index > entryBar
    float  exitPx = na
    string why    = ""
    if not inHold
        exitPx := open
        why    := "EOD"
    else if pos == 1
        if low <= stopPx                         // stop checked first: conservative when both hit
            exitPx := math.min(open, stopPx)
            why    := "SL"
        else if high >= targetPx
            exitPx := math.max(open, targetPx)
            why    := "TP"
    else
        if high >= stopPx
            exitPx := math.max(open, stopPx)
            why    := "SL"
        else if low <= targetPx
            exitPx := math.min(open, targetPx)
            why    := "TP"

    if not na(exitPx)
        float pnl = (exitPx - entryPx) * pos * qty * pv - commission * qty
        dayPnL += pnl
        netPnL += pnl
        trades += 1
        wins   += pnl > 0 ? 1 : 0
        label.new(bar_index, pos == 1 ? high : low, why + "\n" + (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#,##0"),
                  style = pos == 1 ? label.style_label_down : label.style_label_up,
                  color = pnl >= 0 ? color.new(colLong, 20) : color.new(colShort, 20), textcolor = color.white, size = size.small)
        alert("MNQ London ORB exit (" + why + ") @ " + str.tostring(exitPx, format.mintick) + " | P&L $" + str.tostring(pnl, "#,##0.00"), alert.freq_once_per_bar)
        status    := "Closed (" + why + ") — done for today"
        exitFired := true
        pos       := 0
    else
        line.set_x2(lnEntry, bar_index)
        line.set_x2(lnStop, bar_index)
        line.set_x2(lnTarget, bar_index)

// ───────────────────────────── Entry (max 1 per day) ─────────────────────────────
if enabled and orReady and rangeOK and not tradedToday and pos == 0 and inEntry
    bool upBreak = entryMode == "Close" ? close > orHigh : high > orHigh
    bool dnBreak = entryMode == "Close" ? close < orLow  : low  < orLow
    if upBreak != dnBreak
        int   d       = upBreak ? 1 : -1
        float px      = entryMode == "Close" ? close : d == 1 ? math.max(open, orHigh) : math.min(open, orLow)
        float sl      = stopMode == "Opposite side" ? (d == 1 ? orLow : orHigh) : (orHigh + orLow) / 2
        float riskPts = math.abs(px - sl)
        int   n       = riskPts > 0 ? sizeFor(riskPts) : 0
        tradedToday := true
        if n >= 1
            pos      := d
            qty      := n
            entryPx  := px
            stopPx   := sl
            targetPx := px + d * rrTarget * riskPts
            entryBar := bar_index
            color c   = d == 1 ? colLong : colShort
            lnEntry  := line.new(bar_index, entryPx, bar_index + 1, entryPx, color = c, width = 2)
            lnStop   := line.new(bar_index, stopPx, bar_index + 1, stopPx, color = colShort, style = line.style_dashed)
            lnTarget := line.new(bar_index, targetPx, bar_index + 1, targetPx, color = colLong, style = line.style_dashed)
            float riskTaken = riskPts * pv * n + commission * n
            string side = d == 1 ? "LONG" : "SHORT"
            label.new(bar_index, d == 1 ? low : high, side + " " + str.tostring(n) + " MNQ\nRisk $" + str.tostring(riskTaken, "#,##0"),
                      style = d == 1 ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.small)
            alert("MNQ London ORB " + side + " " + str.tostring(n) + " contracts @ " + str.tostring(entryPx, format.mintick) +
                  " | SL " + str.tostring(stopPx, format.mintick) + " | TP " + str.tostring(targetPx, format.mintick) +
                  " | Risk $" + str.tostring(riskTaken, "#,##0.00"), alert.freq_once_per_bar_close)
            status     := "In trade: " + side + " " + str.tostring(n)
            longFired  := d == 1
            shortFired := d == -1
        else
            status := "Skipped — 1 contract risks more than $" + str.tostring(riskUSD, "#,##0")

if orReady and rangeOK and not tradedToday and pos == 0 and not inEntry and inEntry[1]
    tradedToday := true
    status      := "No breakout in window"

// ───────────────────────────── Plots & alerts ─────────────────────────────
plotshape(longFired,  "Long entry",  shape.triangleup,   location.belowbar, colLong,  size = size.tiny)
plotshape(shortFired, "Short entry", shape.triangledown, location.abovebar, colShort, size = size.tiny)

alertcondition(longFired,  "ORB long",  "MNQ London ORB long entry")
alertcondition(shortFired, "ORB short", "MNQ London ORB short entry")
alertcondition(exitFired,  "ORB exit",  "MNQ London ORB position closed")

// ───────────────────────────── Info table ─────────────────────────────
var table info = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 20), border_width = 1)

if showTable and barstate.islast
    float rngNow   = orHigh - orLow
    float estStop  = stopMode == "Opposite side" ? rngNow : rngNow / 2
    int   estQty   = na(rngNow) ? 0 : sizeFor(estStop)
    color txt      = color.white
    table.cell(info, 0, 0, "Symbol", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 0, isMNQ ? "MNQ ✓" : syminfo.root + " ✗ MNQ only", text_color = isMNQ ? colLong : colShort)
    table.cell(info, 0, 1, "Timeframe", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 1, tfOK ? timeframe.period + " ✓" : "Use ≤15m that divides 15", text_color = tfOK ? colLong : colShort)
    table.cell(info, 0, 2, "Range H / L", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 2, na(orHigh) ? "—" : str.tostring(orHigh, format.mintick) + " / " + str.tostring(orLow, format.mintick) + "  (" + str.tostring(rngNow, "#.##") + " pts)", text_color = txt)
    table.cell(info, 0, 3, "Risk / trade", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 3, "$" + str.tostring(riskUSD, "#,##0") + " (" + str.tostring(riskPct) + "%)", text_color = txt)
    table.cell(info, 0, 4, pos != 0 ? "Position" : "Est. size", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 4, pos != 0 ? str.tostring(qty) + " @ " + str.tostring(entryPx, format.mintick) : str.tostring(estQty) + " contracts", text_color = txt)
    table.cell(info, 0, 5, "Status", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 5, enabled ? status : "Disabled", text_color = txt)
    table.cell(info, 0, 6, "Today P&L", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 6, "$" + str.tostring(dayPnL, "#,##0.00"), text_color = dayPnL >= 0 ? colLong : colShort)
    table.cell(info, 0, 7, "Net P&L", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 7, "$" + str.tostring(netPnL, "#,##0.00"), text_color = netPnL >= 0 ? colLong : colShort)
    table.cell(info, 0, 8, "Trades / Win %", text_color = txt, text_halign = text.align_left)
    table.cell(info, 1, 8, str.tostring(trades) + " / " + (trades > 0 ? str.tostring(100.0 * wins / trades, "#.#") + "%" : "—"), text_color = txt)
